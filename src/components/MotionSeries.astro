---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Video } from '../data/site';
// Mirrors the Motion tab "Featured series" (player left, storyboard grid right).
// The player shows the poster until someone presses play, then loads the YouTube
// player (privacy-enhanced youtube-nocookie.com). Storyboard frames switch videos.
interface Props {
  title: string;
  summary: string;
  meta: string[];
  tint: string;
  playlist: string;
  videos: Video[];
}
const { title, summary, meta, tint, playlist, videos } = Astro.props;
const first = videos[0];
// Pre-sized posters so switching videos doesn't load the full PNGs
const posters = await Promise.all(videos.map((v) => getImage({ src: v.poster, width: 1280, format: 'webp' })));
---
<div class="series" data-series>
  <div class="series__main">
    <div class="series__player" style={`--tint:${tint}`}>
      <div class="player" data-player data-video={first.id}>
        <Image src={first.poster} alt="" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, 800px" class="player__poster" data-poster loading="lazy" />
        <button type="button" class="player__play" data-play aria-label={`Play ${first.title}`}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><path d="M11 7.5v17a1.2 1.2 0 0 0 1.8 1l13.6-8.5a1.2 1.2 0 0 0 0-2L12.8 6.5A1.2 1.2 0 0 0 11 7.5Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
    <div class="series__info">
      <div class="series__text">
        <h3 class="t-h3">{title}</h3>
        <p class="t-body">{summary}</p>
        <ul class="series__tags" aria-label="Project details">
          {meta.map((m) => <li class="tag t-caption">{m}</li>)}
        </ul>
      </div>
      <a class="series__yt" href={playlist} target="_blank" rel="noopener noreferrer" aria-label="Watch on YouTube (opens in a new tab)">
        <span class="t-label">Watch on YouTube</span>
        <Icon name="external" size={18} />
      </a>
    </div>
  </div>

  <ul class="series__board" aria-label={`All ${videos.length} videos`}>
    {videos.map((v, i) => (
      <li>
        <button
          type="button"
          class="frame"
          data-frame
          data-video={v.id}
          data-title={v.title}
          data-poster-src={posters[i].src}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <span class="frame__thumb">
            <Image src={v.poster} alt="" widths={[320, 640]} sizes="(max-width: 767px) 44vw, 200px" class="frame__img" loading="lazy" />
          </span>
          <span class="frame__meta t-caption">
            <span class="frame__num">{v.number}</span>
            <span class="frame__title">{v.title}</span>
            <span class="frame__dur">
              <span class="frame__time">{v.duration}</span>
              <span class="frame__playing">Playing</span>
            </span>
          </span>
        </button>
      </li>
    ))}
    <li>
      <a class="frame frame--playlist" href={playlist} target="_blank" rel="noopener noreferrer" aria-label="Full playlist on YouTube (opens in a new tab)">
        <span class="frame__thumb frame__thumb--link t-label-strong">Full playlist <Icon name="external" size={16} /></span>
      </a>
    </li>
  </ul>
</div>

<script>
  for (const series of document.querySelectorAll<HTMLElement>('[data-series]')) {
    const player = series.querySelector<HTMLElement>('[data-player]');
    const playBtn = series.querySelector<HTMLButtonElement>('[data-play]');
    const poster = series.querySelector<HTMLImageElement>('[data-poster]');
    const frames = [...series.querySelectorAll<HTMLButtonElement>('[data-frame]')];
    if (!player || !playBtn) continue;

    const load = (id: string, title: string) => {
      const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1&cc_lang_pref=en`;
      let frame = player.querySelector('iframe');
      if (!frame) {
        frame = document.createElement('iframe');
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.allowFullscreen = true;
        player.append(frame);
        player.classList.add('is-playing');
      }
      frame.title = `${title} (YouTube video)`;
      frame.src = src;
      player.dataset.video = id;
    };

    playBtn.addEventListener('click', () => {
      const current = frames.find((f) => f.getAttribute('aria-current') === 'true');
      load(player.dataset.video ?? '', current?.dataset.title ?? '');
    });

    for (const f of frames) {
      f.addEventListener('click', () => {
        for (const other of frames) other.removeAttribute('aria-current');
        f.setAttribute('aria-current', 'true');
        if (poster && f.dataset.posterSrc) {
          poster.removeAttribute('srcset');
          poster.src = f.dataset.posterSrc;
        }
        playBtn.setAttribute('aria-label', `Play ${f.dataset.title}`);
        load(f.dataset.video ?? '', f.dataset.title ?? '');
        // On phones the player sits above the list: bring it into view
        if (window.matchMedia('(max-width: 767px)').matches) player.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  }
</script>

<style>
  .series {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-24);
    align-items: start;
  }
  .series__main {
    display: grid;
    gap: var(--space-32);
    min-width: 0;
  }
  .series__player {
    padding: var(--space-24);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    box-shadow: var(--shadow-media);
  }
  .player__poster,
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .player__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding-left: 4px;
    border: 0;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow-floating);
    color: var(--color-text-primary);
    cursor: pointer;
    translate: -50% -50%;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .player__play:hover {
    transform: scale(1.06);
  }
  .player.is-playing .player__play,
  .player.is-playing .player__poster {
    display: none;
  }
  .series__info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-32);
  }
  .series__text {
    display: grid;
    gap: var(--space-12);
    max-width: 628px;
  }
  .series__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }
  .tag {
    padding: var(--space-4) var(--space-10);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
  /* Same look as Button variant=secondary (with external icon) */
  .series__yt {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 44px;
    padding: var(--space-12) var(--space-20);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-action-secondary);
    color: var(--color-text-primary);
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .series__yt:hover {
    background: var(--color-action-secondary-hover);
    border-color: var(--color-icon-default);
  }
  .series__yt:focus-visible {
    border-radius: var(--radius-full);
  }

  /* Storyboard */
  .series__board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-24) var(--space-16);
  }
  .frame {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .frame__thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
  }
  .frame__thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-radius: inherit;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .frame:hover .frame__img {
    transform: scale(1.04);
  }
  .frame[aria-current='true'] .frame__thumb::after {
    border-color: var(--color-accent-brand);
  }
  .frame__meta {
    display: flex;
    gap: var(--space-8);
  }
  .frame__num {
    flex: none;
  }
  .frame__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame__dur {
    flex: none;
  }
  .frame__playing {
    display: none;
  }
  .frame[aria-current='true'] .frame__num,
  .frame[aria-current='true'] .frame__playing {
    color: var(--color-accent-text);
  }
  .frame[aria-current='true'] .frame__playing {
    display: inline;
  }
  .frame[aria-current='true'] .frame__time {
    display: none;
  }
  .frame__thumb--link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
  }
  .frame--playlist:hover .frame__thumb--link {
    background: var(--color-bg-surface);
  }

  @media (max-width: 1023px) {
    .series {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-40);
    }
    .series__board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .series__player {
      padding: var(--space-16);
      border-radius: var(--radius-md);
    }
    .player__play {
      width: 56px;
      height: 56px;
    }
    .player__play svg {
      width: 22px;
      height: 22px;
    }
    .series__info {
      flex-direction: column;
      gap: var(--space-16);
    }
    .series__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Titles wrap on phones instead of cutting off */
    .frame__meta {
      flex-wrap: wrap;
      row-gap: 2px;
    }
    .frame__title {
      order: 3;
      flex-basis: 100%;
      white-space: normal;
    }
  }
</style>
