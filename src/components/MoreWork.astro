---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import BackLink from './BackLink.astro';
import { projects } from '../data/site';
// Mirrors Figma "More work" (heading + Project Row list). Every other project, kept quiet.
interface Props {
  current: string;
}
const { current } = Astro.props;
const others = projects.filter((p) => p.slug !== current);
---
<section class="more" aria-labelledby="more-title" data-reveal>
  <div class="more__heading">
    <h2 class="t-h3" id="more-title">More work</h2>
    <div class="more__back more__back--top"><BackLink /></div>
  </div>
  <ul class="more__list">
    {others.map((p) => (
      <li>
        <a class="row" href={`/work/${p.slug}`}>
          <span class="row__thumb" style={`--tint:${p.tint}`}>
            {p.media.kind === 'browser' ? (
              <Image src={p.media.image} alt="" widths={[112, 224]} sizes="112px" class="row__img" />
            ) : (
              <Image src={p.media.screens[1]} alt="" widths={[64, 128]} sizes="40px" class="row__img row__img--phone" />
            )}
          </span>
          <span class="row__text">
            <span class="t-label-strong">{p.title}</span>
            <span class="t-caption row__summary">{p.summary}</span>
          </span>
          <Icon name="arrow-right" size={20} class="row__arrow" />
        </a>
      </li>
    ))}
  </ul>
  <div class="more__back more__back--bottom"><BackLink /></div>
</section>

<style>
  .more {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--layout-gutter);
    row-gap: var(--space-16);
  }
  .more__heading {
    grid-column: 1 / 5;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-8);
  }
  .more__list {
    grid-column: 6 / 13;
    max-width: 640px;
  }
  .more__back--bottom {
    display: none;
  }
  @media (max-width: 767px) {
    .more__back--bottom {
      display: block;
      grid-column: 1 / -1;
    }
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-20);
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }
  .row__thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 112px;
    height: 72px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--tint);
  }
  .row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .row__img--phone {
    width: 40px;
    height: auto;
    margin-top: 16px;
    border-radius: 6px;
    box-shadow: var(--shadow-media);
  }
  .row__text {
    flex: 1;
    display: grid;
    gap: var(--space-4);
  }
  .row__summary {
    color: var(--color-text-secondary);
  }
  .row :global(.row__arrow) {
    flex: none;
    color: var(--color-text-tertiary);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .row:hover :global(.row__arrow),
  .row:focus-visible :global(.row__arrow) {
    color: var(--color-accent-brand);
    transform: translateX(4px);
  }
  .row:hover .row__img {
    transform: scale(1.05);
  }

  @media (max-width: 1023px) {
    .more__heading,
    .more__list {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .more__back--top {
      display: none;
    }
    .row {
      gap: var(--space-16);
    }
    .row__thumb {
      width: 88px;
      height: 56px;
    }
  }
</style>
