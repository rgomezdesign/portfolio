---
// Mirrors Figma "Case/Callout" — one key statement, aligned to the body column.
interface Props {
  statement: string;
  support: string;
}
const { statement, support } = Astro.props;
---
<div class="callout-row" data-reveal>
  <blockquote class="callout">
    <p class="t-h2">{statement}</p>
    <p class="t-body">{support}</p>
  </blockquote>
</div>

<style>
  .callout-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--layout-gutter);
  }
  .callout {
    grid-column: 6 / 13;
    display: grid;
    gap: var(--space-8);
    max-width: 640px;
    margin: 0;
    padding-left: var(--space-24);
    border-left: 2px solid var(--color-accent-brand);
  }
  @media (max-width: 1023px) {
    .callout {
      grid-column: 1 / -1;
    }
  }
</style>
