---
import Icon from './Icon.astro';
interface Props {
  email: string;
}
const { email } = Astro.props;
---
<div class="copy-email">
  <span class="t-body copy-email__address" data-email>{email}</span>
  <span class="t-caption" aria-hidden="true">·</span>
  <button class="copy-email__btn t-label-strong" type="button" data-copy-email={email}>
    <span class="copy-email__icon" aria-hidden="true">
      <Icon name="copy" size={16} class="copy-email__copy" />
      <Icon name="check" size={16} class="copy-email__check" />
    </span>
    <span data-copy-label>Copy</span>
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .copy-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }
  .copy-email__address {
    color: var(--color-text-secondary);
    user-select: all;
  }
  .copy-email__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 44px;
    padding: 0 var(--space-8);
    margin-left: calc(var(--space-8) * -1);
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-accent-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .copy-email__btn:hover {
    background: var(--color-accent-subtle);
  }
  .copy-email__icon {
    position: relative;
    width: 16px;
    height: 16px;
  }
  .copy-email__icon :global(svg) {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-spring);
  }
  .copy-email__icon :global(.copy-email__check) {
    opacity: 0;
    transform: scale(0.5);
  }
  .copy-email__btn.is-copied :global(.copy-email__copy) {
    opacity: 0;
    transform: scale(0.5);
  }
  .copy-email__btn.is-copied :global(.copy-email__check) {
    opacity: 1;
    transform: scale(1);
  }
</style>
