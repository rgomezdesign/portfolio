---
import { Image } from 'astro:assets';
import type { Screen } from '../data/cases/types';
// Mirrors Figma "Demo/Compare": drag the divider to compare two aligned images (wireframe → final).
interface Props {
  before: Screen & { label: string };
  after: Screen & { label: string };
  caption: string;
  tint: string;
}
const { before, after, caption, tint } = Astro.props;
---
<figure class="compare" data-reveal>
  <div class="compare__panel" style={`--tint:${tint}`}>
    <p class="compare__try t-label-strong">Try it: drag to compare <span aria-hidden="true">↔</span></p>
    <div class="frame" data-compare style="--pos:50%">
      <Image src={after.src} alt={after.alt} widths={[800, 1536]} sizes="(max-width: 767px) 92vw, 1040px" class="frame__img" loading="lazy" />
      <div class="frame__before" aria-hidden="true">
        <Image src={before.src} alt="" widths={[800, 1536]} sizes="(max-width: 767px) 92vw, 1040px" class="frame__img" loading="lazy" />
      </div>
      <span class="tag tag--before t-caption">{before.label}</span>
      <span class="tag tag--after t-caption">{after.label}</span>
      <span class="divider" aria-hidden="true"><span class="knob">↔</span></span>
      <label class="frame__range">
        <span class="visually-hidden">Compare {before.label} and {after.label}</span>
        <input type="range" min="0" max="100" value="50" data-compare-input aria-valuetext="50% wireframe" />
      </label>
    </div>
  </div>
  <figcaption class="t-caption">{caption}</figcaption>
</figure>

<style>
  .compare {
    display: grid;
    gap: var(--space-16);
    margin: 0;
  }
  .compare__panel {
    display: grid;
    gap: var(--space-24);
    padding: var(--space-48) var(--space-64) var(--space-64);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }
  .compare__try {
    color: var(--color-accent-text);
  }
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-media);
    user-select: none;
  }
  .frame__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .tag {
    position: absolute;
    top: var(--space-16);
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.85);
    color: var(--color-text-primary);
    pointer-events: none;
  }
  .tag--before {
    left: var(--space-16);
  }
  .tag--after {
    right: var(--space-16);
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
    translate: -50% 0;
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-text-primary);
    box-shadow: var(--shadow-floating);
    font-size: 16px;
    translate: -50% -50%;
    transition: scale var(--duration-base) var(--ease-spring);
  }
  .frame:active .knob {
    scale: 1.1;
  }
  .frame__range input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .frame:focus-within .knob {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }
  @media (max-width: 1023px) {
    .compare__panel {
      padding: var(--space-40) var(--space-24) var(--space-48);
    }
  }
  @media (max-width: 767px) {
    .compare__panel {
      padding: var(--space-24) var(--space-16) var(--space-32);
      border-radius: var(--radius-md);
    }
    .knob {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = frame.querySelector<HTMLInputElement>('[data-compare-input]');
    if (!input) continue;
    const set = () => {
      frame.style.setProperty('--pos', `${input.value}%`);
      input.setAttribute('aria-valuetext', `${input.value}% wireframe`);
    };
    input.addEventListener('input', set);
    set();
  }
</script>
