---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SystemSpecimen from './SystemSpecimen.astro';
import type { Project } from '../data/site';
// Mirrors Figma "Project Card" (Size Default/Compact handled by container units) + Media/Browser, Media/Phones.
interface Props {
  project: Project;
  index?: number;
  /** Full-width card at the top of the grid: media and text side by side (stacks on phones) */
  featured?: boolean;
  /** Scroll-reveal animation (off for cards inside hidden tab panels) */
  reveal?: boolean;
}
const { project, index = 0, featured = false, reveal = true } = Astro.props;
const { slug, title, summary, meta, tint, media } = project;
---
<li class:list={['card-item', { 'card-item--featured': featured }]} data-reveal={reveal ? '' : undefined} style={`--i:${index % 2}`}>
  <a class:list={['card', { 'card--featured': featured }]} href={`/work/${slug}`}>
    <div class="card__media" style={`--tint:${tint}`}>
      {media.kind === 'browser' ? (
        <div class="browser">
          <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[560, 840, 1120]}
            sizes="(max-width: 767px) 90vw, (max-width: 1023px) 44vw, 560px"
            class="browser__shot"
            loading={index < 2 ? 'eager' : 'lazy'}
          />
        </div>
      ) : media.kind === 'specimen' ? (
        <div class="specimen" role="img" aria-label={media.alt}><SystemSpecimen system={media.system} /></div>
      ) : (
        <div class="phones" role="img" aria-label={media.alt}>
          {media.screens.map((src, p) => (
            <div class:list={['phone', { 'phone--raised': p === 1 }]}>
              <Image src={src} alt="" widths={[200, 400]} sizes="(max-width: 767px) 26vw, 160px" class="phone__img" loading={index < 2 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>
      )}
    </div>
    <div class="card__text">
      <div class="card__title-row">
        <h3 class:list={[featured ? 't-h2' : 't-h3']}>{title}</h3>
        <Icon name="arrow-right" size={20} class="card__arrow" />
      </div>
      <p class="t-body">{summary}</p>
      <ul class="card__tags" aria-label="Project details">
        {meta.map((m) => <li class="tag t-caption">{m}</li>)}
      </ul>
    </div>
  </a>
</li>

<style>
  .card {
    display: grid;
    gap: var(--space-24);
    border-radius: var(--radius-lg);
  }
  .card:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }

  /* Media panel: tinted, the frame inside bleeds off the bottom edge */
  .card__media {
    position: relative;
    aspect-ratio: 624 / 412;
    overflow: hidden;
    container-type: inline-size;
    border-radius: var(--radius-lg);
    background: var(--tint);
    isolation: isolate;
  }

  .browser,
  .phones {
    transition:
      transform 520ms var(--ease-out),
      box-shadow 520ms var(--ease-out);
  }
  .card:hover .browser,
  .card:focus-visible .browser,
  .card:hover .phones,
  .card:focus-visible .phones {
    transform: translateY(-8px);
  }

  .browser {
    position: absolute;
    top: 11.5cqw;
    left: 5.2cqw;
    right: 5.2cqw;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-media);
  }
  .card:hover .browser {
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.05),
      0 18px 40px -10px rgb(0 0 0 / 0.16);
  }
  .browser__bar {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-10) var(--space-14);
    background: var(--color-bg-subtle);
  }
  .browser__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }
  .browser__shot {
    width: 100%;
    height: auto;
    aspect-ratio: 560 / 334;
    object-fit: cover;
    object-position: top;
  }

  /* nutu phones — real screens from the case study */
  .phones {
    position: absolute;
    top: 9cqw;
    left: 50%;
    display: flex;
    align-items: flex-start;
    gap: 2.6cqw;
    translate: -50% 0;
  }
  .phone {
    width: 25.6cqw;
    margin-top: 6.4cqw;
  }
  .phone--raised {
    margin-top: 0;
  }
  .phone__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 375 / 812;
    border: 1px solid var(--color-border-default);
    border-radius: 2.6cqw;
    box-shadow: var(--shadow-media);
  }

  .card__text {
    display: grid;
    gap: var(--space-8);
  }
  .card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }
  .card :global(.card__arrow) {
    flex: none;
    color: var(--color-accent-brand);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .card:hover :global(.card__arrow),
  .card:focus-visible :global(.card__arrow) {
    color: var(--color-accent-text);
    transform: translateX(4px);
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-8);
  }
  /* Mirrors Figma "Tag" */
  .tag {
    padding: var(--space-4) var(--space-10);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* Featured: spans both columns, media left and text right */
  @media (min-width: 768px) {
    .card-item--featured {
      grid-column: 1 / -1;
    }
    .card--featured {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-48);
    }
    .card--featured .card__text {
      gap: var(--space-12);
      max-width: 440px;
    }
  }

  @media (max-width: 767px) {
    .card {
      gap: var(--space-16);
    }
    .card__media {
      aspect-ratio: 350 / 252;
    }
    .phone {
      width: 26.5cqw;
    }
  }
</style>
