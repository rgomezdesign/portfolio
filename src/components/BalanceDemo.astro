---
import { Image } from 'astro:assets';
import type { Screen } from '../data/cases/types';
// Mirrors Figma "Demo/Balance": the real Future You screen with its gauge + slider card made live.
// The card and the right photo's zone tag/border are drawn at app scale (375 wide, values from the
// Future You Figma file) and laid exactly over the screenshot, then scaled with the phone.
interface Props {
  caption: string;
  screens: { good: Screen; off: Screen };
  tint: string;
}
const { caption, screens, tint } = Astro.props;
const START = 12;
---
<figure class="balance" data-reveal>
  <div class="balance__panel" style={`--tint:${tint}`} data-balance-demo>
    <div class="phone">
      <Image src={screens.good.src} alt={screens.good.alt} widths={[400, 750]} sizes="(max-width: 767px) 300px, 340px" class="phone__shot" loading="lazy" />
      <Image src={screens.off.src} alt={screens.off.alt} widths={[400, 750]} sizes="(max-width: 767px) 300px, 340px" class="phone__shot phone__shot--off" loading="lazy" />

      <div class="app" aria-label="Future You gauge and slider (interactive)">
        <span class="app__frame" aria-hidden="true"></span>
        <span class="app__tag" aria-hidden="true" data-zone>Green zone</span>

        <div class="card">
          <div class="card__head">
            <p>If you consistently stay here</p>
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.6" /><path d="M10 9v4.6M10 6.3v.2" /></svg>
          </div>

          <div class="gauge" aria-hidden="true">
            <span class="gauge__arc"></span>
            <span class="gauge__cap gauge__cap--l"></span><span class="gauge__cap gauge__cap--r"></span>
            <span class="gauge__pointer" data-pointer><i></i></span>
            <span class="gauge__face"><span class="gauge__sign" data-sign>+</span><span data-value>{START}</span></span>
          </div>

          <label class="slider">
            <span class="visually-hidden">If you consistently stay here, daily balance from −100 to +100</span>
            <input type="range" min="-100" max="100" step="1" value={START} data-slider />
          </label>
          <div class="axis" aria-hidden="true">
            <span>-100</span><span class="axis__zero">0</span><span>+100</span>
          </div>
        </div>
      </div>
    </div>

    <div class="side">
      <p class="side__try t-label-strong"><span class="side__arrow" aria-hidden="true">←</span> Try it: drag the slider</p>
      <p class="t-body">Anywhere in the green gives the same future. Drift into yellow or orange, in either direction, and the picture changes with you.</p>
      <ul class="legend t-caption" aria-label="Zones">
        <li><i style="--c:var(--color-demo-zone-good)"></i>Green: a balanced day</li>
        <li><i style="--c:var(--color-demo-zone-mid)"></i>Yellow: drifting</li>
        <li><i style="--c:var(--color-demo-zone-off)"></i>Orange: well off balance</li>
      </ul>
    </div>
  </div>
  <figcaption class="t-caption">{caption}</figcaption>
</figure>

<style>
  .balance {
    display: grid;
    gap: var(--space-16);
    margin: 0;
  }
  .balance__panel {
    --phone: 340px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-80);
    padding: var(--space-64);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }

  /* Phone: screenshot + live overlay at app scale (375 × 812) */
  .phone {
    position: relative;
    flex: none;
    width: var(--phone);
    aspect-ratio: 375 / 812;
    overflow: hidden;
    border-radius: calc(var(--phone) * 0.1);
    box-shadow: var(--shadow-media);
    background: var(--color-demo-nutu-surface);
  }
  .phone::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid var(--color-border-default);
    border-radius: inherit;
    pointer-events: none;
  }
  .phone__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .phone__shot--off {
    opacity: 0;
  }
  .is-changed .phone__shot--off {
    opacity: 1;
  }

  .app {
    position: absolute;
    top: 0;
    left: 0;
    width: 375px;
    height: 812px;
    transform: scale(var(--s, 0.9067));
    transform-origin: 0 0;
    color: var(--color-demo-nutu-ink);
    font-size: 12px;
    line-height: 1.33;
  }
  .app p {
    margin: 0;
  }
  /* Right photo: zone border + tag (covers the ones baked into the screenshot) */
  .app__frame {
    position: absolute;
    top: 176px;
    left: 193px;
    width: 166px;
    height: 240px;
    border: 2px solid var(--zone);
    border-radius: 8px;
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .app__tag {
    position: absolute;
    top: 166px;
    left: 205px;
    min-width: 92px;
    height: 20px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--zone);
    color: #fff;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-out);
  }
  .is-mid .app__tag {
    color: var(--color-demo-nutu-ink);
  }

  /* "Gauge + Slider" card: 343 × 255 at (16, 432) */
  .card {
    position: absolute;
    top: 432px;
    left: 16px;
    display: flex;
    flex-direction: column;
    width: 343px;
    height: 255px;
    padding: 16px;
    border: 0.5px solid var(--color-demo-nutu-line);
    border-radius: 8px;
    background: #fff;
  }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 20px;
    font-size: 14px;
    font-weight: 500;
  }
  .card__head svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #434343;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .gauge {
    position: relative;
    width: 158px;
    height: 141px;
    margin: 10px auto 0;
  }
  /* Arc measured from the real screen: 16px band (r 62.5–78.5), 236° sweep, round ends,
     green band sits slightly left of top */
  .gauge__arc {
    position: absolute;
    inset: 0 0 auto;
    height: 158px;
    background: conic-gradient(
      from -118deg,
      #f17a2b 0deg,
      #f19e2d 17deg,
      #f1cf2f 33deg,
      #f0d32f 41deg,
      var(--color-demo-zone-good) 81deg 129deg,
      #f0d32f 169deg,
      #f1d330 177deg,
      #f0a52c 209deg,
      #f17a2b 236deg,
      transparent 236deg
    );
    -webkit-mask: radial-gradient(circle, transparent 62.25px, #000 62.75px 78.25px, transparent 78.75px);
    mask: radial-gradient(circle, transparent 62.25px, #000 62.75px 78.25px, transparent 78.75px);
  }
  .gauge__cap {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #f17a2b;
  }
  .gauge__cap--l {
    top: 104.1px;
    left: 8.75px;
  }
  .gauge__cap--r {
    top: 104.1px;
    left: 133.25px;
  }
  .gauge__pointer {
    position: absolute;
    top: 0;
    left: 0;
    width: 158px;
    height: 158px;
    transform: rotate(var(--a, 14.2deg));
    transition: transform 420ms var(--ease-spring);
  }
  .gauge__pointer i {
    position: absolute;
    top: 18px;
    left: 72.5px;
    width: 13px;
    height: 19px;
    background: var(--zone-ink);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    border-radius: 2px;
    transition: background-color var(--duration-base) var(--ease-out);
  }
  .gauge__face {
    position: absolute;
    top: 30px;
    left: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 98px;
    height: 98px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px rgb(56 56 40 / 0.07);
    color: var(--zone-text);
    font-size: 32.7px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    transition: color var(--duration-base) var(--ease-out);
  }
  .gauge__sign {
    margin-right: 2px;
    font-size: 16px;
    font-weight: 600;
  }

  /* Slider: 6px track #D3D596, 24px thumb with 3px #496257 ring */
  .slider {
    display: block;
    margin-top: auto;
  }
  .slider input {
    display: block;
    width: 100%;
    height: 26px;
    margin: 0;
    background: transparent;
    cursor: grab;
    -webkit-appearance: none;
    appearance: none;
    touch-action: pan-y;
  }
  .slider input:active {
    cursor: grabbing;
  }
  .slider input::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: var(--color-demo-nutu-track);
  }
  .slider input::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: var(--color-demo-nutu-track);
  }
  .slider input::-webkit-slider-thumb {
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    margin-top: -9px;
    border: 3px solid var(--color-demo-nutu-primary);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
    -webkit-appearance: none;
    appearance: none;
    transition: transform var(--duration-base) var(--ease-spring);
  }
  .slider input::-moz-range-thumb {
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    border: 3px solid var(--color-demo-nutu-primary);
    border-radius: 50%;
    background: #fff;
  }
  .slider input:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  .slider input:focus-visible {
    outline: none;
  }
  .slider input:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px rgb(222 110 33 / 0.45);
  }
  .axis {
    display: flex;
    justify-content: space-between;
    color: var(--color-demo-nutu-muted);
  }
  .axis__zero {
    color: var(--color-demo-nutu-ink);
    font-weight: 500;
  }

  /* Zone colors */
  [data-balance-demo] {
    --zone: var(--color-demo-zone-good);
    --zone-ink: var(--color-demo-zone-good-ink);
    --zone-text: var(--color-demo-zone-good);
  }
  .is-mid {
    --zone: var(--color-demo-zone-mid);
    --zone-ink: #b39a12;
    --zone-text: #b39a12;
  }
  .is-off {
    --zone: var(--color-demo-zone-off);
    --zone-ink: var(--color-demo-zone-off);
    --zone-text: var(--color-demo-zone-off);
  }

  /* Portfolio annotation beside the phone */
  .side {
    flex: 0 1 340px;
    display: grid;
    gap: var(--space-16);
  }
  .side__try {
    color: var(--color-accent-text);
  }
  .side__arrow {
    display: inline-block;
    animation: nudge-left 1.6s var(--ease-out) infinite;
  }
  @keyframes nudge-left {
    0%,
    60%,
    100% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(-4px);
    }
  }
  .legend {
    display: grid;
    gap: var(--space-6);
    color: var(--color-text-secondary);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  @media (max-width: 1023px) {
    .balance__panel {
      gap: var(--space-40);
      padding: var(--space-48) var(--space-24);
    }
  }
  @media (max-width: 767px) {
    .balance__panel {
      --phone: min(300px, calc(100vw - 72px));
      --s: 0.8;
      flex-direction: column;
      gap: var(--space-24);
      padding: var(--space-32) var(--space-16);
      border-radius: var(--radius-md);
    }
    .side {
      flex: none;
      order: -1;
    }
    .side__arrow {
      rotate: -90deg;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-balance-demo]')) {
    const input = root.querySelector<HTMLInputElement>('[data-slider]');
    const pointer = root.querySelector<HTMLElement>('[data-pointer]');
    const value = root.querySelector<HTMLElement>('[data-value]');
    const sign = root.querySelector<HTMLElement>('[data-sign]');
    const tag = root.querySelector<HTMLElement>('[data-zone]');
    const phone = root.querySelector<HTMLElement>('.phone');
    if (!input || !pointer || !value || !sign || !tag || !phone) continue;

    // Scale the app-sized overlay (375px wide) to the phone's rendered width
    new ResizeObserver(() => root.style.setProperty('--s', String(phone.clientWidth / 375))).observe(phone);

    // The arc sweeps 236°, so −100 → −118° and +100 → +118° from the top
    const render = () => {
      const v = Number(input.value);
      const abs = Math.abs(v);
      pointer.style.setProperty('--a', `${v * 1.18}deg`);
      value.textContent = String(abs);
      sign.textContent = v > 0 ? '+' : v < 0 ? '−' : '';
      const zone = abs <= 35 ? 'good' : abs <= 60 ? 'mid' : 'off';
      root.classList.toggle('is-mid', zone === 'mid');
      root.classList.toggle('is-off', zone === 'off');
      root.classList.toggle('is-changed', zone !== 'good');
      tag.textContent = zone === 'good' ? 'Green zone' : zone === 'mid' ? 'Yellow zone' : 'Orange zone';
      input.setAttribute('aria-valuetext', `${sign.textContent}${abs}, ${tag.textContent}`);
    };
    input.addEventListener('input', render);
    render();
  }
</script>
