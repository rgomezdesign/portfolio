---
// Mirrors Figma "Case/Meta" — a row of label/value pairs under the case study title.
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---
<dl class="meta">
  {items.map((m) => (
    <div class="meta__item">
      <dt class="t-caption">{m.label}</dt>
      <dd class="t-label-strong">{m.value}</dd>
    </div>
  ))}
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-16) var(--layout-gutter);
    margin: 0;
    padding-top: var(--space-16);
  }
  .meta__item {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border-default);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 767px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: var(--space-8);
    }
  }
</style>
