---
// Mirrors the Figma Icons page (24px grid). Stroke uses currentColor.
export type IconName = 'arrow-right' | 'external' | 'work' | 'about' | 'experience' | 'contact' | 'check' | 'copy';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6" stroke-width="1.8"/>',
  external: '<path d="M8 16L16 8M9.5 8H16v6.5" stroke-width="1.8"/>',
  work: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" stroke-width="1.7"/>',
  about: '<circle cx="12" cy="8.5" r="3.5" stroke-width="1.7"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" stroke-width="1.7"/>',
  experience: '<rect x="3.5" y="7.5" width="17" height="12" rx="2.5" stroke-width="1.7"/><path d="M9 7.5V6a2 2 0 012-2h2a2 2 0 012 2v1.5M3.5 12.5h17" stroke-width="1.7"/>',
  contact: '<rect x="3.5" y="5.5" width="17" height="13" rx="2.5" stroke-width="1.7"/><path d="M4.5 7l7.5 6 7.5-6" stroke-width="1.7"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" stroke-width="1.9"/>',
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="2.5" stroke-width="1.7"/><path d="M15.5 8.5V6.5a2 2 0 00-2-2h-7a2 2 0 00-2 2v7a2 2 0 002 2h2" stroke-width="1.7"/>',
};
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
