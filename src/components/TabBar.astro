---
import Icon from './Icon.astro';
import { nav } from '../data/site';
// Mirrors Figma "Tab Bar": Work · About · Contact. Mobile only (<768px). Fixed 238px so only the highlight moves.
---
<nav class="tabbar" aria-label="Primary" data-nav-root>
  {nav.map((t, i) => (
    <a class:list={['tab', { 'is-active': i === 0 }]} href={`#${t.id}`} data-nav-link={t.id} aria-label={t.label} aria-current={i === 0 ? 'true' : undefined}>
      <Icon name={t.icon} size={22} />
      <span class="tab__label" aria-hidden="true"><span class="t-label-strong">{t.label}</span></span>
    </a>
  ))}
</nav>

<style>
  .tabbar {
    display: none;
  }
  @media (max-width: 767px) {
    .tabbar {
      position: fixed;
      left: 50%;
      bottom: calc(24px + env(safe-area-inset-bottom, 0px));
      z-index: 50;
      display: flex;
      gap: var(--space-4);
      width: 238px;
      padding: var(--space-6);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-full);
      background: rgb(255 255 255 / 0.92);
      -webkit-backdrop-filter: saturate(1.6) blur(14px);
      backdrop-filter: saturate(1.6) blur(14px);
      box-shadow: var(--shadow-floating);
      transform: translateX(-50%);
      animation: tabbar-in 700ms var(--ease-out) 300ms both;
    }
  }
  @keyframes tabbar-in {
    from {
      opacity: 0;
      transform: translate(-50%, 16px);
    }
  }
  .tab {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 46px;
    min-height: 46px;
    padding: var(--space-12);
    border-radius: var(--radius-full);
    color: var(--color-icon-default);
    transition:
      flex-grow 420ms var(--ease-spring),
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .tab:active {
    transform: scale(0.96);
  }
  .tab.is-active {
    flex-grow: 1;
    background: var(--color-accent-subtle);
    color: var(--color-accent-text);
  }
  /* Label unfolds from 0 width when its tab becomes active */
  .tab__label {
    display: grid;
    grid-template-columns: 0fr;
    opacity: 0;
    transition:
      grid-template-columns 420ms var(--ease-spring),
      opacity var(--duration-base) var(--ease-out),
      margin var(--duration-base) var(--ease-out);
  }
  .tab__label > span {
    overflow: hidden;
    white-space: nowrap;
  }
  .tab.is-active .tab__label {
    grid-template-columns: 1fr;
    margin-left: var(--space-8);
    opacity: 1;
  }
</style>
