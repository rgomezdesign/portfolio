---
import Base from '../../layouts/Base.astro';
import Brand from '../../components/Brand.astro';
import PillNav from '../../components/PillNav.astro';
import TabBar from '../../components/TabBar.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import BackLink from '../../components/BackLink.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseCallout from '../../components/CaseCallout.astro';
import CaseScreens from '../../components/CaseScreens.astro';
import GoalDemo from '../../components/GoalDemo.astro';
import BalanceDemo from '../../components/BalanceDemo.astro';
import MoreWork from '../../components/MoreWork.astro';
import CaseBrowser from '../../components/CaseBrowser.astro';
import ResizeDemo from '../../components/ResizeDemo.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import CompareDemo from '../../components/CompareDemo.astro';
import LiveSite from '../../components/LiveSite.astro';
import ChatDemo from '../../components/ChatDemo.astro';
import SystemParts from '../../components/SystemParts.astro';
import SystemFigure from '../../components/SystemFigure.astro';
import { projects, systems } from '../../data/site';
import { caseStudies } from '../../data/cases';

// Mirrors the Figma case study template ("nutu · Desktop 1440" / "nutu · Mobile 390").
// Projects without a written case study yet fall back to a short placeholder.
export function getStaticPaths() {
  return [...projects, ...systems].map((project) => ({
    params: { slug: project.slug },
    props: { project, isSystem: systems.includes(project) },
  }));
}
const { project, isSystem } = Astro.props;
// System pages go back to the Systems tab on the home page
const backHref = isSystem ? '/#systems' : '/#work';
const study = caseStudies[project.slug];
const year = new Date().getFullYear();
---
<Base title={`${project.title} — Roman Gomez`} description={study?.lead ?? project.summary}>
  <header class="top page">
    <Brand />
  </header>
  <PillNav base="/" />

  <main id="main" class="page case" data-protect-images>
    {study ? (
      <>
        <header class="case__header">
          <div class="enter" style="--i:0"><BackLink href={backHref} /></div>
          <div class="case__eyebrow enter" style="--i:1">
            <Eyebrow text={study.eyebrow} />
            {study.status && <span class="case__status t-caption">{study.status}</span>}
          </div>
          <h1 class="t-display enter" style="--i:2">{study.title}</h1>
          <p class="case__lead t-lead enter" style="--i:3">{study.lead}</p>
          <div class="enter" style="--i:4"><CaseMeta items={study.meta} /></div>
          {study.live && (
            <div class="enter" style="--i:5">
              {study.live.internal ? (
                <Button href={study.live.href} variant="secondary" icon="arrow-right">{study.live.label}</Button>
              ) : (
                <Button href={study.live.href} variant="secondary" icon="external" external>{study.live.label}</Button>
              )}
            </div>
          )}
        </header>

        <div class="enter" style="--i:5">
          {study.cover.kind === 'phones' ? (
            <CaseScreens screens={study.cover.screens} tint={project.tint} size="cover" eager />
          ) : study.cover.kind === 'parts' ? (
            <SystemParts caption={study.cover.caption} tint={project.tint} />
          ) : study.cover.kind === 'image' ? (
            <CaseGallery images={[study.cover.shot]} caption={study.cover.caption} tint={project.tint} layout="portrait" />
          ) : (
            <CaseBrowser shot={study.cover.shot} url={study.cover.url} phone={study.cover.phone} tint={project.tint} size="cover" eager />
          )}
        </div>

        {study.chapters.map((chapter) => (
          <div class="case__chapter">
            {chapter.map((block) =>
              block.type === 'section' ? (
                <CaseSection kicker={block.kicker} title={block.title} body={block.body} />
              ) : block.type === 'screens' ? (
                <CaseScreens screens={block.screens} caption={block.caption} tint={project.tint} />
              ) : block.type === 'goal-demo' ? (
                <GoalDemo statement={block.statement} support={block.support} tint={project.tint} />
              ) : block.type === 'browser' ? (
                <CaseBrowser shot={block.shot} url={block.url} phone={block.phone} caption={block.caption} tint={project.tint} />
              ) : block.type === 'resize-demo' ? (
                <ResizeDemo caption={block.caption} url={block.url} shots={block.shots} tint={project.tint} />
              ) : block.type === 'gallery' ? (
                <CaseGallery images={block.images} caption={block.caption} layout={block.layout} tint={project.tint} />
              ) : block.type === 'compare' ? (
                <CompareDemo before={block.before} after={block.after} caption={block.caption} size={block.size} tint={project.tint} />
              ) : block.type === 'chat-demo' ? (
                <ChatDemo statement={block.statement} support={block.support} tint={project.tint} />
              ) : block.type === 'live' ? (
                <LiveSite src={block.src} url={block.url} caption={block.caption} hint={block.hint} title={block.title} tint={project.tint} />
              ) : block.type === 'token-layers' || block.type === 'decisions' || block.type === 'playground' || block.type === 'name-map' || block.type === 'contrast' || block.type === 'stats' || block.type === 'strip' ? (
                <SystemFigure block={block} tint={project.tint} />
              ) : block.type === 'balance-demo' ? (
                <BalanceDemo caption={block.caption} screens={block.screens} tint={project.tint} />
              ) : (
                <CaseCallout statement={block.statement} support={block.support} />
              ),
            )}
          </div>
        ))}
      </>
    ) : (
      <header class="case__header">
        <BackLink />
        <p class="t-caption">{project.meta.join(' · ')}</p>
        <h1 class="t-display">{project.title}</h1>
        <p class="case__lead t-lead">{project.summary}. The full case study is on its way.</p>
      </header>
    )}

    <MoreWork current={project.slug} />
  </main>

  <footer class="footer page">
    <p class="t-caption">© {year} Roman Gomez</p>
  </footer>

  <TabBar base="/" />
</Base>

<script>
  // Case study images: no right-click "Save image" and no drag-to-desktop. (Screenshots can't be blocked.)
  const main = document.querySelector<HTMLElement>('[data-protect-images]');
  const isImage = (t: EventTarget | null) => t instanceof Element && !!t.closest('img, picture');
  main?.addEventListener('contextmenu', (e) => isImage(e.target) && e.preventDefault());
  main?.addEventListener('dragstart', (e) => isImage(e.target) && e.preventDefault());
</script>

<style>
  .case :global(img) {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }
  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }
  /* Mirrors Figma "Tag", with a dot for status */
  .case__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-10);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
  .case__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-brand);
  }
  .top {
    position: absolute;
    top: 46px;
    left: 0;
    right: 0;
    z-index: 40;
  }
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-112);
    padding-top: var(--space-160);
  }
  .case__header {
    display: grid;
    justify-items: start;
    gap: var(--space-24);
  }
  .case__header > :global(*) {
    max-width: 100%;
  }
  .case__header > div:has(.meta) {
    justify-self: stretch;
  }
  .case__lead {
    max-width: 760px;
  }
  .case__chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-48);
  }
  .footer {
    padding-top: var(--space-112);
    padding-bottom: var(--space-48);
  }
  .footer p {
    padding-top: var(--space-48);
    border-top: 1px solid var(--color-border-default);
  }

  @media (max-width: 1023px) {
    .case {
      padding-top: 152px;
    }
  }

  @media (max-width: 767px) {
    .top {
      position: static;
      padding-top: var(--space-24);
    }
    .case {
      gap: var(--space-64);
      padding-top: var(--space-24);
    }
    .case__header {
      gap: var(--space-20);
    }
    .case__chapter {
      gap: var(--space-32);
    }
    .footer {
      padding-top: var(--space-64);
      padding-bottom: 112px;
    }
  }
</style>
